            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def d = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()); if (d.catalogItem.price != 35.50 || d.catalogItem.id.toString() != vars.get('itemId')) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Precio o ID no actualizado'); }</stringProp>
          </JSR223Assertion>
